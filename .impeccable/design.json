      { "name": "The Purple Restraint Rule", "body": "Le violet Smart Eat ne remplace pas le bleu action.", "section": "colors" },
      { "name": "The Short Ramp Rule", "body": "Une app POS n'a pas besoin de vingt tailles.", "section": "typography" },
